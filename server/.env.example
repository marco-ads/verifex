# VERIFEX Backend — copia este archivo como .env
# Obtén tu API key gratis en: https://console.groq.com

GROQ_API_KEY=tu_api_key_aqui

# Puerto del servidor Flask (producción usa el puerto de Railway)
FLASK_PORT=5001

# (Opcional) Facebook App para analizar posts públicos
# Crea una app en https://developers.facebook.com y pega aquí tus credenciales
# FACEBOOK_APP_ID=tu_app_id
# FACEBOOK_APP_SECRET=tu_app_secret
